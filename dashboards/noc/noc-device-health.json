{
  "uid": "noc-device-health",
  "title": "NOC — Device Health",
  "description": "Any router, switch or firewall monitored by Zabbix: choose Device Type, Device and Interfaces at the top. Hosts, interfaces and metrics are read from Zabbix (host groups, interface discovery tags, item tags and names) — nothing is hardcoded.",
  "tags": [
    "noc",
    "netops",
    "device-health"
  ],
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "timezone": "browser",
  "weekStart": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "devtype",
        "label": "Device Type",
        "type": "custom",
        "hide": 0,
        "query": "All : @@NOCQ_ALL@@,Router : @@NOCQ_ROUTER@@,Switch : @@NOCQ_SWITCH@@,Firewall : @@NOCQ_FIREWALL@@",
        "current": {
          "selected": true,
          "text": "All",
          "value": "@@NOC_ALL@@"
        },
        "options": [],
        "multi": false,
        "includeAll": false,
        "skipUrlSync": false,
        "description": "Zabbix host groups per device type (regex over group names); set once by 'install.sh --dashboards'"
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "zabbix-lab"
        },
        "hide": 0,
        "query": {
          "queryType": "host",
          "group": "${devtype:raw}",
          "host": "/.*/",
          "application": "",
          "itemTag": "",
          "item": ""
        },
        "definition": "Zabbix hosts in the host groups of the selected Device Type",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "regex": "",
        "skipUrlSync": false,
        "description": "Every Zabbix host in the groups of the chosen type; new hosts appear on the next dashboard load"
      },
      {
        "name": "interface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "zabbix-lab"
        },
        "hide": 0,
        "query": {
          "queryType": "itemTag",
          "group": "${devtype:raw}",
          "host": "$device",
          "application": "",
          "itemTag": "/^[Ii]nterface: /",
          "item": ""
        },
        "definition": "Zabbix item tags 'interface: <name>' of the selected device (interface discovery)",
        "refresh": 1,
        "sort": 7,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "/^(?<value>[Ii]nterface: (?<text>.+))$/",
        "skipUrlSync": false,
        "description": "Interfaces Zabbix discovered on the device (item tag 'interface')"
      }
    ]
  },
  "links": [
    {
      "title": "NOC dashboards",
      "type": "dashboards",
      "tags": [
        "noc"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
