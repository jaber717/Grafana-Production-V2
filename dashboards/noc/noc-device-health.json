    {
      "id": 2,
      "type": "stat",
      "title": "Reachability (ICMP)",
      "description": "Zabbix item 'ICMP ping' (template ICMP Ping). 'no item' = the device has no ICMP ping item.",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix-lab"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "no item",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "blue",
                "value": -1000000000000.0
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
