{
  "uid": "noc-wan-overview",
  "title": "NOC — Network Overview",
  "description": "All devices of the selected Device Type (Zabbix host groups) at a glance. Open 'NOC — Device Health' for one device and its interfaces.",
  "tags": [
    "noc",
    "netops",
    "overview"
  ],
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "timezone": "browser",
  "weekStart": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "devtype",
        "label": "Device Type",
        "type": "custom",
        "hide": 0,
        "query": "All : @@NOCQ_ALL@@,Router : @@NOCQ_ROUTER@@,Switch : @@NOCQ_SWITCH@@,Firewall : @@NOCQ_FIREWALL@@",
        "current": {
          "selected": true,
          "text": "All",
          "value": "@@NOC_ALL@@"
        },
        "options": [],
        "multi": false,
        "includeAll": false,
        "skipUrlSync": false,
        "description": "Zabbix host groups per device type (regex over group names); set once by 'install.sh --dashboards'"
      }
    ]
  },
  "links": [
    {
      "title": "NOC dashboards",
      "type": "dashboards",
      "tags": [
        "noc"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Reachability (ICMP) — every device of the type",
      "description": "One row per device in the host groups of the selected type.",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix-lab"
      },
      "gridPos": {
        "h": 14,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Field"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "displayName",
                "value": "Device / item"
              },
              {
                "id": "custom.minWidth",
                "value": 230
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ICMP"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows",
            "includeTimeField": false
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Last *": "ICMP"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "zabbix-lab"
          },
          "queryType": "0",
          "group": {
            "filter": "${devtype:raw}"
          },
          "host": {
            "filter": "/.*/"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/^ICMP ping$/"
          },
          "functions": [],
          "proxy": {
            "filter": ""
          },
          "trigger": {
            "filter": ""
          },
          "tags": {
            "filter": ""
          },
          "macro": {
            "filter": ""
          },
          "options": {
            "showDisabledItems": false,
            "skipEmptyValues": false,
            "disableDataAlignment": false,
            "useZabbixValueMapping": false
          },
          "table": {
            "skipEmptyValues": false
          }
        }
      ]
    },
