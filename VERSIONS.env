# Pinned versions of what runs on grafana-01 (captured 2026-10-10). Sourced by the LXC scripts and checked by scripts/verify.mjs.
GRAFANA_VERSION=13.2.3
GRAFANA_COMMIT=90ffed056f0884267356c12a0eeb72a022af53f1
GRAFANA_OS=debian-12
GRAFANA_RPM_RELEASE=1
GRAFANA_RPM_NEVRA=grafana-13.2.3-1.x86_64
GRAFANA_RPM_REPO_URL=https://rpm.grafana.com
GRAFANA_RPM_GPG_FPR=B53AE77BADB630A683046005963FA27710458545
GRAFANA_RPM_GPG_EXPIRES=2027-08-22

# Node.js used by the content tools when the host has no suitable Node.js and PACKAGE_SOURCE=bundle (official tarball, SHA-256 pinned here;
# the value was taken from https://nodejs.org/dist/v20.20.2/SHASUMS256.txt). With PACKAGE_SOURCE=repo, AppStream's nodejs (module nodejs:20) is used.
NODE_BUNDLE_VERSION=v20.20.2
NODE_BUNDLE_FILE=node-v20.20.2-linux-x64.tar.xz
NODE_BUNDLE_SHA256=df770b2a6f130ed8627c9782c988fda9669fa23898329a61a871e32f965e007d

# The exact package file in the Grafana repository for GRAFANA_RPM_NEVRA, and its SHA-256 (taken from the downloaded, signature-verified file).
# Used by tools/build-offline-bundle.sh; the online install relies on repository metadata signatures and the package signature instead.
GRAFANA_RPM_FILE=grafana_13.2.3_36482603486_linux_amd64.rpm
GRAFANA_RPM_SHA256=4fc2adc0912421b630696423d5c05ee2df560347fdb5e906a927fffc3201d066

# Fallback source of the pinned artifacts when the server has no bundle and cannot reach rpm.grafana.com: the offline archive published as a
# release asset of jaber717/Grafana 1.0.1 (public; read-only use). It carries exactly the Grafana RPM, plugins and Node.js pinned above.
# The archive's SHA-256 is checked first, then every artifact against the pins above. Override with BUNDLE_URL/BUNDLE_URL_SHA256 in the env file.
BUNDLE_FALLBACK_URL=https://github.com/jaber717/Grafana/releases/download/v1.0.1/grafana-platform-1.0.1-rhel9-offline.tar.gz
BUNDLE_FALLBACK_SHA256=fc0232d92ce09596a69dbc2f1d06b08b214ab8bb35115b189bd4fd239c0e8f76
