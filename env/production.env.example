# PRODUCTION environment for grafana-platform on RHEL 9 (release 2.x).
# Standard installation: sudo ./install.sh asks the questions and writes /etc/grafana-platform/platform.env for you.
# Advanced, non-interactive:                  bin/grafana-platform init-env /root/grafana.env KEY=VALUE KEY=VALUE ...
# Change a value later:                         grafana-platform config set KEY=VALUE [--env-file /root/grafana.env]
# NON-SECRET settings only. Passwords are files under SECRETS_DIR, created with: grafana-platform secret set <name>
# Every key below is the complete list: an unknown or misspelled key is an ERROR (it is never silently ignored).
# Yes/no settings accept yes/no, true/false, on/off, 1/0 (any case). Nothing in this file is expanded: write literal values, no $VARS.
PLATFORM_ENV=production

# --- Grafana listener -------------------------------------------------------------------------------------------------
# name or IP address users put in the browser (must be in the certificate when https)
GRAFANA_DOMAIN=grafana.example.com
GRAFANA_HTTP_PORT=3000
# https (default) | http.  http ALSO needs GRAFANA_ALLOW_INSECURE_HTTP=yes (reported as WARN on every preflight/verify)
GRAFANA_PROTOCOL=https
GRAFANA_ALLOW_INSECURE_HTTP=no
# https only: PEM certificate (+ intermediates) and private key; copied to /etc/grafana/tls
GRAFANA_TLS_CERT_FILE=/root/tls/grafana.crt
GRAFANA_TLS_KEY_FILE=/root/tls/grafana.key
# PEM CA that signed the certificate above, if it is not already in the system trust store (self-signed: the certificate itself)
GRAFANA_TLS_CA_FILE=
# space-separated sources admitted by firewalld; REQUIRED, there is no default
GRAFANA_ALLOWED_CIDRS=10.0.0.0/24
GRAFANA_ADMIN_USER=admin

# --- Zabbix datasource (uid zabbix-lab is kept: the dashboards reference it) ---------------------------------------------
# no = install Grafana without Zabbix (no Zabbix datasource, NOC dashboards deferred); add it later: sudo ./install.sh --zabbix
ZABBIX_ENABLED=yes
ZABBIX_DS_NAME=Zabbix
# uid of a Zabbix datasource that already exists in Grafana (created by hand): the NOC dashboards use it and it is never modified.
# Empty = the installer creates and manages its own datasource (uid zabbix-lab). Set by "sudo ./install.sh --dashboards" when you choose it.
ZABBIX_DATASOURCE_UID=
# the API endpoint; http:// ALSO needs ALLOW_INSECURE_DATASOURCES=yes
ZABBIX_URL=https://zabbix.example.com/api_jsonrpc.php
# a READ-ONLY Zabbix user (store its password with: grafana-platform secret set zabbix-password)
ZABBIX_USER=grafana-ro
# PEM CA that signed the Zabbix certificate (installed into the system trust store); empty = system trust only
ZABBIX_CA_FILE=
# keep false; true is refused unless ALLOW_INSECURE_DATASOURCES=yes
ZABBIX_TLS_SKIP_VERIFY=false
# yes = accept datasources over plain HTTP (Zabbix http://, ClickHouse without TLS) or with certificate checks off. Default no.
ALLOW_INSECURE_DATASOURCES=no

# --- ClickHouse datasource (Akvorado NetFlow) ----------------------------------------------------------------------------
# no = defer NetFlow: no ClickHouse datasource, no NetFlow dashboards/playlist, no clickhouse-password needed (WARN, never half-deployed)
CLICKHOUSE_ENABLED=yes
CLICKHOUSE_HOST=netflow.example.com
# empty = 8443 with TLS, 8123 without
CLICKHOUSE_PORT=8443
# TLS to ClickHouse (Akvorado repository: CLICKHOUSE_TLS=yes). false ALSO needs ALLOW_INSECURE_DATASOURCES=yes
CLICKHOUSE_SECURE=true
# store its password with: grafana-platform secret set clickhouse-password
CLICKHOUSE_USER=grafana_ro
CLICKHOUSE_CA_FILE=

# --- NOC dashboards: Zabbix item ids differ per Zabbix server -------------------------------------------------------------
# built by: grafana-platform item-map   (docs/ZABBIX-ITEM-MAP.md)
ZABBIX_ITEM_MAP_FILE=/etc/grafana-platform/zabbix-item-map.json
# yes (default) = defer the 2 NOC dashboards while the map is missing or incomplete (WARN; never deployed half-mapped); no = treat that as an error
ALLOW_NOC_WITHOUT_ITEM_MAP=yes

# --- Packages -----------------------------------------------------------------------------------------------------------
# auto (default) = use the offline bundle when one is present (BUNDLE_DIR, default: ./bundle of this release), else the Internet
# repo = rpm.grafana.com + grafana.com | bundle = offline bundle only
PACKAGE_SOURCE=auto
# empty = <release directory>/bundle
BUNDLE_DIR=
# only if no bundle/archive is present and rpm.grafana.com is unreachable: where to download the pinned offline archive from
# empty = the published 1.0.1 archive (same pins, see VERSIONS.env BUNDLE_FALLBACK_URL). A custom URL REQUIRES its SHA-256.
BUNDLE_URL=
BUNDLE_URL_SHA256=

# --- Storage / backups ---------------------------------------------------------------------------------------------------
SECRETS_DIR=/etc/grafana-platform/secrets
BACKUP_DIR=/var/backups/grafana-platform
BACKUP_KEEP=8
# if set, backup archives are encrypted (gpg symmetric AES256) with the passphrase in this file
BACKUP_GPG_PASSPHRASE_FILE=
