# LAB / reference environment (grafana-01, Debian LXC). Reproduces the datasource definitions captured from the running instance
# (config/datasources.json); tests/unit asserts that rendering this file equals that capture. Used with scripts/apply.sh / verify.sh only:
# the LAB host is NOT installed with grafana-platform (it is a Debian LXC; production is RHEL 9).
PLATFORM_ENV=lab
ZABBIX_DS_NAME=Zabbix LAB
ZABBIX_URL=https://192.168.1.91:8443/api_jsonrpc.php
ZABBIX_USER=grafana-ro
ZABBIX_TLS_SKIP_VERIFY=true
CLICKHOUSE_HOST=192.168.1.195
CLICKHOUSE_PORT=8123
CLICKHOUSE_SECURE=false
CLICKHOUSE_USER=grafana_ro
# the LAB grafana-01 used the plugin default
ZABBIX_CACHE_TTL=1h
